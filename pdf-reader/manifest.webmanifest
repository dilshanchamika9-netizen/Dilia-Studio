{
 "name": "Dilia PDF",
 "short_name": "Dilia PDF",
 "description": "Read PDFs privately: tabs, bookmarks, search, print, measure and read aloud. Files stay on your device.",
 "id": "./",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "background_color": "#ffffff",
 "theme_color": "#ffffff",
 "icons": [
  {
   "src": "../assets/app/icon-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "../assets/app/icon-512.png",
   "sizes": "512x512",
   "type": "image/png"
  },
  {
   "src": "../assets/app/maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ],
 "file_handlers": [
  {
   "action": "./",
   "accept": {
    "application/pdf": [
     ".pdf"
    ]
   },
   "icons": [
    {
     "src": "../assets/app/icon-192.png",
     "sizes": "192x192",
     "type": "image/png"
    }
   ]
  }
 ],
 "launch_handler": {
  "client_mode": [
   "focus-existing",
   "auto"
  ]
 },
 "categories": [
  "productivity",
  "utilities"
 ]
}
